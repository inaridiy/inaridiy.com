							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{ "_type": "span", "text": "このサイトについて", "_key": "k3" }
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "EmDash (CMS) + Astro を Cloudflare Workers 上で動かしています。データベースは D1、メディアは R2。記事は Workers AI / AI Gateway 経由で自動的に英訳され、検索には Cloudflare AI Search を使っています。",
									"_key": "k5"
								}
							],
							"_key": "k4"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "この文章は管理画面 (/_emdash/admin) からいつでも書き換えられます。",
									"_key": "k7"
								}
							],
							"_key": "k6"
						}
					]
				}
			}
		],
		"posts": [
			{
				"id": "post-hello",
				"slug": "hello-inaridiy-com",
				"status": "published",
				"data": {
					"title": "inaridiy.com を作り直した",
					"excerpt": "EmDash + Cloudflare Workers でブログを作り直した。D1・AI Search・AI Gateway 経由の自動英訳つき。",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "個人サイトを EmDash で作り直した。構成は次の通り。",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [{ "_type": "span", "text": "構成", "_key": "k3" }],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "CMS は EmDash。Astro ベースで、Cloudflare Workers にそのままデプロイできる。コンテンツは D1 (SQLite)、画像などのメディアは R2 に入る。管理画面もセルフホストされる。",
									"_key": "k5"
								}
							],
							"_key": "k4"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "記事を公開すると、プラグインが AI Gateway 経由で LLM を呼び出して英訳を生成する。使うモデルは AI Gateway の設定で切り替えられる。検索は Cloudflare AI Search (旧 AutoRAG) で、公開済みの記事が R2 に Markdown として書き出され、自動でインデックスされる。",
									"_key": "k7"
								}
							],
							"_key": "k6"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "見た目は HackerNews 風に、テキスト主体の簡素なリストにした。装飾より本文。",
									"_key": "k9"
								}
							],
							"_key": "k8"
						}
					]
				},
				"bylines": [{ "byline": "byline-inaridiy" }],
				"taxonomies": {
					"category": ["dev"],
					"tag": ["web", "cloudflare", "ai"]
