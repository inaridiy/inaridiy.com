{
  "name": "inaridiy-com",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Blog",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "pnpm build:plugins && astro dev",
    "build:plugins": "pnpm --filter emdash-plugin-github-sync build",
    "build": "pnpm build:plugins && astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "astro check",
    "typecheck:workspaces": "tsc -p packages/content-contract/tsconfig.json && tsc -p plugins/cache-purge/tsconfig.json && tsc -p plugins/github-sync/tsconfig.json && tsc -p plugins/newsletter/tsconfig.json && tsc -p plugins/translator/tsconfig.json",
    "typecheck:bindings": "WRANGLER_HIDE_BANNER=true wrangler types --check",
    "test": "node --test tests/*.test.mjs && pnpm --filter emdash-plugin-github-sync test",
    "check:bundle": "node scripts/check-bundle-sizes.mjs",
    "check:deploy": "WRANGLER_HIDE_BANNER=true wrangler deploy --dry-run --outdir dist/wrangler-dry-run",
    "check": "pnpm build:plugins && pnpm typecheck && pnpm typecheck:workspaces && pnpm typecheck:bindings && pnpm test && EMDASH_ENCRYPTION_KEY=check-only-placeholder pnpm build && pnpm check:bundle",
    "content:pull": "pnpm build:plugins && node plugins/github-sync/dist/cli.mjs pull",
    "content:push": "pnpm build:plugins && node plugins/github-sync/dist/cli.mjs push"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "^1.1.0",
    "@inaridiy/content-contract": "workspace:*",
    "astro": "^7.3.5",
    "emdash": "^1.1.0",
    "emdash-plugin-cache-purge": "workspace:*",
    "emdash-plugin-github-sync": "workspace:*",
    "emdash-plugin-newsletter": "workspace:*",
    "emdash-plugin-translator": "workspace:*",
    "katex": "^0.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.5.0",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261002.1",
    "wrangler": "^4.146.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
