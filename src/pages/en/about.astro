---
import ContentPage from "../../components/ContentPage.astro";
import Base from "../../layouts/Base.astro";
import { getLocalizedEntryBySourceSlug, staticAlternates } from "../../utils/i18n";

const { entry: page, isTranslated, cacheHints } = await getLocalizedEntryBySourceSlug(
	"pages",
	"about",
	"en",
);
for (const cacheHint of cacheHints) Astro.cache.set(cacheHint);
const title = page?.data.title || "About";
---

<Base
	{title}
	description="About inaridiy"
	canonical={`${Astro.url.origin}/en/about`}
	lang="en"
	alternates={staticAlternates("/about")}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{
		page ? (
			<ContentPage {title} content={page.data.content} lang="en" {isTranslated} />
		) : (
			<p class="empty">No about page yet.</p>
		)
	}
</Base>

<style>.empty { color: var(--color-text-secondary); }</style>
