---
import { getEmDashEntry } from "emdash";
import ContentPage from "../../components/ContentPage.astro";
import Base from "../../layouts/Base.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "about");
Astro.cache.set(cacheHint);
const title = page?.data.title_en || page?.data.title || "About";
const content = page?.data.content_en || page?.data.content;
---

<Base
	{title}
	description="About inaridiy"
	canonical={`${Astro.url.origin}/en/about`}
	lang="en"
	alternates={[
		{ hreflang: "ja", path: "/about" },
		{ hreflang: "en", path: "/en/about" },
		{ hreflang: "x-default", path: "/about" },
	]}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	{
		page ? (
			<ContentPage
				{title}
				{content}
				lang="en"
				isTranslated={Boolean(page.data.content_en)}
			/>
		) : (
			<p class="empty">No about page yet.</p>
		)
	}
</Base>

<style>.empty { color: var(--color-text-secondary); }</style>
