---
import ActivityList from "../../components/ActivityList.astro";
import Base from "../../layouts/Base.astro";
import { getAllPublishedActivities } from "../../utils/activities";
import { staticAlternates } from "../../utils/i18n";

const { entries, cacheHints } = await getAllPublishedActivities("en");
for (const cacheHint of cacheHints) Astro.cache.set(cacheHint);
---

<Base
	title="Activities"
	description="Activity log"
	canonical={`${Astro.url.origin}/en/activities`}
	lang="en"
	alternates={staticAlternates("/activities")}
>
	<h1 class="page-title">Activities</h1>
	<ActivityList activities={entries} lang="en" />
</Base>

<style>
	.page-title { font-size: var(--font-size-xl); margin-bottom: var(--spacing-6); }
</style>
