---
import {
	decodeSlug,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
	type ContentSeo,
} from "emdash";
import LikeButton from "../../../components/LikeButton.astro";
import PostArticle from "../../../components/PostArticle.astro";
import Base from "../../../layouts/Base.astro";
import { descriptionFromContent } from "../../../utils/description";
import { getReadingTime } from "../../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.redirect("/404");
Astro.cache.set(cacheHint);

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const title = post.data.title_en || post.data.title;
const excerpt = post.data.excerpt_en || post.data.excerpt;
const content = post.data.content_en || post.data.content;
const storedSeo: unknown = Reflect.get(post.data, "seo");
const sourceSeo =
	typeof storedSeo === "object" && storedSeo !== null
		? (storedSeo as Partial<ContentSeo>)
		: {};
const localizedPost = {
	data: {
		...post.data,
		title,
		excerpt,
		seo: {
			title: null,
			description: null,
			canonical: null,
			image: sourceSeo.image ?? null,
			noIndex: sourceSeo.noIndex ?? false,
		} satisfies ContentSeo,
	},
};
const seo = getSeoMeta(localizedPost, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/en/posts/${slug}`,
	defaultOgImage: `${Astro.url.origin}/og/posts/${slug}.png?lang=en`,
});
// Excerpt-less posts otherwise ship no <meta name="description">
const description = seo.description || descriptionFromContent(content, title);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	lang="en"
	markdownUrl={`/en/posts/${slug}.md`}
	alternates={[
		{ hreflang: "ja", path: `/posts/${slug}` },
		{ hreflang: "en", path: `/en/posts/${slug}` },
		{ hreflang: "x-default", path: `/posts/${slug}` },
	]}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<PostArticle
		{slug}
		{title}
		{content}
		publishDate={post.data.publishedAt?.toISOString().slice(0, 10) ?? null}
		readingTime={getReadingTime(content)}
		lang="en"
		isTranslated={Boolean(post.data.content_en)}
	/>
	<LikeButton {slug} lang="en" />
</Base>
