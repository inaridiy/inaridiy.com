---
import { localizedPath, TARGET_LOCALE } from "@inaridiy/content-contract";
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import LikeButton from "../../../components/LikeButton.astro";
import PostArticle from "../../../components/PostArticle.astro";
import Base from "../../../layouts/Base.astro";
import { descriptionFromContent } from "../../../utils/description";
import { alternatesFor, getPublishedTranslations } from "../../../utils/i18n";
import { getReadingTime } from "../../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

// Unknown English slugs fall back to the Japanese entry with that slug
// (i18n fallback chain): a post whose translation is missing or offline, or
// an /en link built from the Japanese slug.
const { entry: post, cacheHint, fallbackLocale } = await getEmDashEntry("posts", slug, {
	locale: TARGET_LOCALE,
});
if (!post) return Astro.redirect("/404");
Astro.cache.set(cacheHint);
const translations = await getPublishedTranslations("posts", post.data.id);
const english = translations.en;
if (fallbackLocale && english) return Astro.redirect(english.path, 301);
const isTranslated = !fallbackLocale;
// Likes and the OG card are keyed by the Japanese slug.
const sourceSlug = translations.ja?.slug ?? slug;

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const path = localizedPath("posts", slug, TARGET_LOCALE);
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path,
	defaultOgImage: `${Astro.url.origin}/og/posts/${sourceSlug}.png?lang=en`,
});
const content = post.data.content;
// Excerpt-less posts otherwise ship no <meta name="description">
const description = seo.description || descriptionFromContent(content, post.data.title);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={description}
	image={seo.ogImage}
	canonical={isTranslated ? seo.canonical : `${Astro.url.origin}${translations.ja?.path ?? path}`}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	lang="en"
	markdownUrl={`${path}.md`}
	alternates={alternatesFor(translations)}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<PostArticle
		title={post.data.title}
		{content}
		publishDate={post.data.publishedAt?.toISOString().slice(0, 10) ?? null}
		readingTime={getReadingTime(content)}
		lang="en"
		{isTranslated}
		otherLanguageHref={translations.ja?.path ?? null}
	/>
	<LikeButton slug={sourceSlug} lang="en" />
</Base>
