---
import { SOURCE_LOCALE } from "@inaridiy/content-contract";
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import LikeButton from "../../components/LikeButton.astro";
import PostArticle from "../../components/PostArticle.astro";
import Base from "../../layouts/Base.astro";
import { descriptionFromContent } from "../../utils/description";
import { alternatesFor, getPublishedTranslations } from "../../utils/i18n";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug, {
	locale: SOURCE_LOCALE,
});
if (!post) return Astro.redirect("/404");
Astro.cache.set(cacheHint);
const translations = await getPublishedTranslations("posts", post.data.id);

function getImageUrl(value: unknown): string | undefined {
	if (!value || typeof value !== "object") return undefined;
	const image = value as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	return storageKey
		? `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`
		: undefined;
}

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
	defaultOgImage:
		getImageUrl(post.data.featured_image) ?? `${Astro.url.origin}/og/posts/${slug}.png`,
});
const content = post.data.content;
// Excerpt-less posts otherwise ship no <meta name="description">
const description = seo.description || descriptionFromContent(content, siteTagline);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	markdownUrl={`/posts/${slug}.md`}
	alternates={alternatesFor(translations)}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<PostArticle
		title={post.data.title}
		{content}
		publishDate={post.data.publishedAt?.toISOString().slice(0, 10) ?? null}
		readingTime={getReadingTime(content)}
		otherLanguageHref={translations.en?.path ?? null}
		categories={post.data.terms?.category ?? []}
		tags={post.data.terms?.tag ?? []}
		titleEdit={post.edit.title}
	/>
	<LikeButton {slug} />
</Base>
