---
export const prerender = false;

import { env } from "cloudflare:workers";
import { search } from "emdash";
import Base from "../layouts/Base.astro";

const MAX_QUERY_CHARS = 300;
const rawQuery = Astro.url.searchParams.get("q")?.trim() || "";
const queryTooLong = rawQuery.length > MAX_QUERY_CHARS;
const query = queryTooLong ? rawQuery.slice(0, MAX_QUERY_CHARS) : rawQuery;
const mode = Astro.url.searchParams.get("mode") === "ai" ? "ai" : "keyword";

// Never edge-cache search: responses are per-visitor (rate-limit cookie) and
// without an explicit header the Workers Cache would apply heuristic
// freshness (~2h) to cookie-less repeat visits.
Astro.response.headers.set("Cache-Control", "private, no-store");

// AI Search binding. Hybrid (vector + keyword/trigram) search handles
// Japanese properly — EmDash's SQLite FTS can't tokenize CJK, so it is
// only the fallback when the binding is absent (plain local dev).
const searchBinding = (env as Partial<Env>).SEARCH;

interface ResultRow {
	url: string;
	title: string;
	snippet?: string;
	/** Pre-sanitized HTML snippet (EmDash FTS <mark> highlighting) */
	snippetHtml?: string;
	lang?: string;
}

let aiAnswer: string | null = null;
let results: ResultRow[] = [];
let searchIssue: "query_too_long" | "rate_limited" | "unavailable" | null = queryTooLong
	? "query_too_long"
	: null;
let usedFts = false;

function visitorRateLimitKey(): string {
	const cookieName = "inaridiy_search_visitor";
	const current = Astro.cookies.get(cookieName)?.value;
	const visitor =
		current && /^[0-9a-f-]{36}$/i.test(current) ? current : crypto.randomUUID();
	if (visitor !== current) {
		Astro.cookies.set(cookieName, visitor, {
			httpOnly: true,
			sameSite: "lax",
			secure: Astro.url.protocol === "https:",
			path: "/",
			maxAge: 365 * 24 * 60 * 60,
		});
	}
	return `ai-search:${visitor}`;
}

function chunksToRows(
	chunks: Array<{ score: number; text: string; item?: { metadata?: Record<string, unknown> } }>,
): ResultRow[] {
	const seen = new Set<string>();
	const rows: ResultRow[] = [];
	for (const chunk of chunks) {
		const meta = chunk.item?.metadata ?? {};
		const url = typeof meta.url === "string" ? meta.url : null;
		if (!url || seen.has(url)) continue;
		seen.add(url);
		rows.push({
			url,
			title: typeof meta.title === "string" ? meta.title : url,
			snippet: chunk.text.replace(/^#[^\n]*\n+|^URL:[^\n]*\n+/gm, "").slice(0, 160),
			lang: typeof meta.lang === "string" ? meta.lang : undefined,
		});
	}
	return rows;
}

if (query && !queryTooLong && searchBinding) {
	const limiter = (env as Partial<Env>).AI_RATE_LIMITER;
	if (limiter) {
		try {
			const result = await limiter.limit({ key: visitorRateLimitKey() });
			if (!result.success) searchIssue = "rate_limited";
		} catch (error) {
			searchIssue = "unavailable";
			console.error({
				event: "search_rate_limit_failed",
				error: error instanceof Error ? error.message : String(error),
			});
		}
	}

	if (!searchIssue) {
		try {
			if (mode === "ai") {
				const [chat, retrieval] = await Promise.all([
					searchBinding.chatCompletions({
						messages: [{ role: "user", content: query }],
					}),
					searchBinding.search({
						query,
						ai_search_options: { retrieval: { max_num_results: 8 } },
					}),
				]);
				aiAnswer = chat.choices?.[0]?.message?.content ?? null;
				results = chunksToRows([...(chat.chunks ?? []), ...(retrieval.chunks ?? [])]).slice(
					0,
					8,
				);
			} else {
				const retrieval = await searchBinding.search({
					query,
					ai_search_options: { retrieval: { max_num_results: 12 } },
				});
				results = chunksToRows(retrieval.chunks ?? []);
			}
		} catch (error) {
			searchIssue = "unavailable";
			console.error({
				event: "ai_search_request_failed",
				mode,
				error: error instanceof Error ? error.message : String(error),
			});
		}
	}
}

// Fallback: EmDash full-text search (local dev / hybrid failure)
if (
	query &&
	!queryTooLong &&
	(!searchBinding || searchIssue === "rate_limited" || searchIssue === "unavailable")
) {
	try {
		usedFts = true;
		const { items } = await search(query, {
			collections: ["posts", "pages", "activities"],
			limit: 30,
		});
		results = items.map((item) => ({
			url:
				item.collection === "pages"
					? (item.slug ?? item.id) === "about"
						? "/about"
						: `/pages/${item.slug ?? item.id}`
					: item.collection === "activities"
						? "/activities"
						: `/posts/${item.slug ?? item.id}`,
			title: item.title ?? "Untitled",
			snippetHtml: item.snippet ?? undefined,
		}));
	} catch (error) {
		searchIssue = "unavailable";
		results = [];
		console.error({
			event: "fts_search_failed",
			error: error instanceof Error ? error.message : String(error),
		});
	}
}
---

<Base title={query ? `Search: ${query}` : "Search"} description="記事検索(ハイブリッド検索 + AI 回答)">
	<h1 class="page-title">Search</h1>

	<form method="get" action="/search" class="search-form">
		<input
			type="search"
			name="q"
			value={query}
			placeholder="キーワード、または AI への質問..."
			class="search-input"
			autofocus
		/>
		<button type="submit" name="mode" value="keyword" class="search-button">検索</button>
		<button type="submit" name="mode" value="ai" class="search-button search-button--ai">
			AI に聞く
		</button>
	</form>

	{
		searchIssue === "query_too_long" && (
			<p class="notice">検索語は{MAX_QUERY_CHARS}文字以内で入力してください。</p>
		)
	}
	{
		searchIssue === "rate_limited" && (
			<p class="notice">
				検索回数が多すぎます。1分ほど待ってから再度お試しください。簡易検索の結果を表示しています。
			</p>
		)
	}
	{
		searchIssue === "unavailable" && (
			<p class="notice">
				AI検索を一時的に利用できません。簡易検索の結果を表示しています。
			</p>
		)
	}
	{
		usedFts && query && !searchIssue && (
			<p class="notice">簡易検索(全文一致)で表示しています。</p>
		)
	}

	{
		aiAnswer && (
			<section class="ai-answer">
				<h2 class="section-label">AI の回答</h2>
				<p class="ai-answer-text">{aiAnswer}</p>
				<p class="ai-note">回答は Cloudflare AI Search (RAG) による自動生成です。</p>
			</section>
		)
	}

	{
		query && (
			<p class="search-summary">
				{results.length === 0
					? `「${query}」に一致する結果はありませんでした`
					: `「${query}」の検索結果: ${results.length}件`}
			</p>
		)
	}

	<ol class="search-results">
		{
			results.map((result) => (
				<li class="search-result">
					<a href={result.url} class="result-title">
						{result.title}
						{result.lang === "en" && <span class="lang-badge">EN</span>}
					</a>
					{result.snippetHtml ? (
						<p class="result-snippet" set:html={result.snippetHtml} />
					) : (
						result.snippet && <p class="result-snippet">{result.snippet}…</p>
					)}
				</li>
			))
		}
	</ol>

	{!query && <p class="hint">キーワード検索、または「AI に聞く」で記事内容への質問ができます。</p>}
</Base>

<style>
	.page-title {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-4);
	}

	.search-form {
		display: flex;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-6);
		flex-wrap: wrap;
	}

	.search-input {
		flex: 1;
		min-width: 200px;
		padding: var(--spacing-2) var(--spacing-3);
		font-size: var(--font-size-base);
		font-family: var(--font-body);
		border: 1px solid var(--input);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--ring);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.search-button {
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-sm);
		font-family: var(--font-body);
		background: var(--primary);
		color: var(--primary-foreground);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
	}

	.search-button--ai {
		background: var(--secondary);
		color: var(--secondary-foreground);
		border: 1px solid var(--border);
	}

	.search-button:hover {
		opacity: 0.9;
	}

	.notice {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		border-left: 2px solid var(--color-border);
		padding-left: var(--spacing-3);
		margin-bottom: var(--spacing-4);
	}

	.ai-answer {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-4);
		margin-bottom: var(--spacing-6);
		background: var(--color-bg-subtle);
	}

	.section-label {
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
	}

	.ai-answer-text {
		white-space: pre-wrap;
		line-height: var(--leading-relaxed);
		margin-bottom: var(--spacing-3);
	}

	.lang-badge {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-left: var(--spacing-1);
	}

	.ai-note {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.search-summary {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		margin-bottom: var(--spacing-4);
	}

	.hint {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.search-results {
		list-style: none;
	}

	.search-result {
		padding: var(--spacing-3) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.search-result:last-child {
		border-bottom: none;
	}

	.result-title {
		color: var(--color-text);
		font-weight: 500;
	}

	.result-title:hover {
		color: var(--color-brand);
	}

	.result-snippet {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		margin-top: var(--spacing-1);
		line-height: var(--leading-snug);
	}

	.result-snippet :global(mark) {
		background: var(--color-brand-ring);
		color: inherit;
		padding: 0 0.1em;
		border-radius: 2px;
	}
</style>
