---
import { getEmDashEntry } from "emdash";
import ContentPage from "../components/ContentPage.astro";
import Base from "../layouts/Base.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "about");
Astro.cache.set(cacheHint);
---

<Base
	title={page?.data.title ?? "About"}
	description="自己紹介"
	canonical={`${Astro.url.origin}/about`}
	markdownUrl="/about.md"
	alternates={[
		{ hreflang: "ja", path: "/about" },
		{ hreflang: "en", path: "/en/about" },
		{ hreflang: "x-default", path: "/about" },
	]}
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	{
		page ? (
			<ContentPage
				title={page.data.title}
				content={page.data.content}
				titleEdit={page.edit.title}
			/>
		) : (
			<section class="empty">
				<h1>About</h1>
				<p>「about」スラッグのページがまだありません。<a href="/_emdash/admin">管理画面</a>で作成してください。</p>
			</section>
		)
	}
</Base>

<style>.empty { color: var(--color-text-secondary); }</style>
