---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	lang?: "ja" | "en";
	alternates?: Array<{ hreflang: string; path: string }>;
	/** Path of the raw-markdown mirror of this page (e.g. `/posts/<slug>.md`). */
	markdownUrl?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	lang = "ja",
	alternates,
	markdownUrl,
	content,
} = Astro.props;
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const ogImage = image ?? `${Astro.url.origin}/og/site.png`;
const socialMenu = await getMenu("social");
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image: ogImage,
	content,
	seo: { ogImage, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		{
			alternates?.map((alternate) => (
				<link
					rel="alternate"
					hreflang={alternate.hreflang}
					href={`${Astro.url.origin}${alternate.path}`}
				/>
			))
		}
		{
			markdownUrl && (
				<link rel="alternate" type="text/markdown" href={`${Astro.url.origin}${markdownUrl}`} />
			)
		}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<SiteHeader siteTitle={siteTitle} lang={lang} isLoggedIn={Boolean(Astro.locals.user)} />
		<main><slot /></main>
		<SiteFooter lang={lang} siteTagline={siteTagline} socialMenu={socialMenu} />
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<style is:global>
	@layer base;

	@layer base {
		*:where(:not([class*="emdash"]):not([class*="ec-"])),
		*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
		*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
			box-sizing: border-box;
		}

		body,
		h1,
		h2,
		h3,
		h4,
		h5,
		h6,
		p,
		ul,
		ol,
		figure,
		blockquote,
		dl,
		dd {
			margin: 0;
		}

		ul,
		ol {
			padding: 0;
		}

		html {
			scroll-behavior: smooth;
		}

		body {
			font-family: var(--font-body);
			font-size: var(--font-size-base);
			line-height: var(--leading-relaxed);
			color: var(--color-text);
			background: var(--color-bg);
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
			min-height: 100dvh;
			display: flex;
			flex-direction: column;
		}

		a:where(:not([class*="emdash"]):not([class*="ec-"])) {
			color: var(--color-brand);
			text-decoration: none;
			transition: color var(--transition-fast);
		}

		a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
			color: var(--color-brand-hover);
		}

		img {
			max-width: 100%;
			height: auto;
			display: block;
		}

		h1,
		h2,
		h3,
		h4,
		h5,
		h6 {
			font-family: var(--font-heading);
			line-height: var(--leading-tight);
			font-weight: var(--font-weight-heading);
			letter-spacing: var(--tracking-snug);
		}

		h1 {
			font-weight: var(--font-weight-display);
			letter-spacing: var(--tracking-tight);
		}

		::selection {
			background: var(--color-brand);
			color: var(--color-on-brand);
		}
	}
</style>

<style>
	main {
		flex: 1 0 auto;
		width: 100%;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-6) var(--spacing-5) var(--spacing-16);
	}
</style>
