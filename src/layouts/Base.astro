---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Page language; JA is the site default, EN pages pass "en" */
	lang?: "ja" | "en";
	/** hreflang alternate links (JA/EN page pairs). Paths, not full URLs. */
	alternates?: Array<{ hreflang: string; path: string }>;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	lang = "ja",
	alternates,
	content,
} = Astro.props;
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());
// If title already includes site title (from getSeoMeta), use as-is
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

// Every page gets an OG image: specific one if the page passed it,
// otherwise the generated site card
const ogImage = image ?? `${Astro.url.origin}/og/site.png`;

const socialMenu = await getMenu("social");

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image: ogImage,
	content,
	seo: { ogImage, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		{
			alternates?.map((alt) => (
				<link
					rel="alternate"
					hreflang={alt.hreflang}
					href={`${Astro.url.origin}${alt.path}`}
				/>
			))
		}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="site-title">{siteTitle}</a>
				<div class="nav-links">
					{
						lang === "ja" ? (
							<>
								<a href="/posts">blog</a>
								<a href="/about">about</a>
								<a href="/en">en</a>
							</>
						) : (
							<>
								<a href="/en">blog</a>
								<a href="/en/about">about</a>
								<a href="/">ja</a>
							</>
						)
					}
					{isLoggedIn && <a href="/_emdash/admin">admin</a>}
				</div>
				<form method="get" action="/search" class="site-search">
					<input
						type="search"
						name="q"
						placeholder="search..."
						class="site-search-input"
						aria-label="Search"
					/>
				</form>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<form class="newsletter-form" data-newsletter>
					<label class="newsletter-label" for="newsletter-email">
						{lang === "ja" ? "新着記事をメールで受け取る" : "Get new posts by email"}
					</label>
					<div class="newsletter-row">
						<input
							id="newsletter-email"
							type="email"
							name="email"
							required
							placeholder="you@example.com"
							class="newsletter-input"
						/>
						<button type="submit" class="newsletter-button">
							{lang === "ja" ? "購読" : "Subscribe"}
						</button>
					</div>
					<p class="newsletter-status" data-newsletter-status></p>
				</form>
				<nav class="footer-links">
					{
						socialMenu?.items.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							>
								{item.label}
							</a>
						))
					}
					<a href="/rss.xml">rss</a>
					<a href="/activities">activities</a>
				</nav>
				{siteTagline && <p class="footer-copyright">{siteTagline}</p>}
			</div>
		</footer>

		<script>
			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const searchInput = document.querySelector(".site-search-input") as HTMLInputElement;
					if (searchInput) searchInput.focus();
				}
			});

			// Newsletter signup (plugin route needs the CSRF header, hence fetch)
			const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
			const status = document.querySelector<HTMLElement>("[data-newsletter-status]");
			const isJa = document.documentElement.lang !== "en";
			form?.addEventListener("submit", async (e) => {
				e.preventDefault();
				const email = new FormData(form).get("email");
				if (!status) return;
				status.textContent = "...";
				try {
					const response = await fetch("/_emdash/api/plugins/newsletter/subscribe", {
						method: "POST",
						headers: { "content-type": "application/json", "X-EmDash-Request": "1" },
						body: JSON.stringify({ email }),
					});
					const result = (await response.json()) as { data?: { ok?: boolean } };
					if (result.data?.ok) {
						status.textContent = isJa
							? "確認メールを送りました。メール内のリンクで購読が完了します。"
							: "Check your inbox — click the link to confirm.";
						form.reset();
					} else {
						status.textContent = isJa ? "登録に失敗しました。" : "Subscription failed.";
					}
				} catch {
					status.textContent = isJa ? "登録に失敗しました。" : "Subscription failed.";
				}
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/theme.css (shadcn-compatible
				 * set, dark only) and src/styles/tokens.css (template defaults).
				 */
				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					/* Exact-fit page: header + main (flex) + footer = 100dvh,
					   no magic-number min-heights to drift out of sync */
					min-height: 100dvh;
					display: flex;
					flex-direction: column;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
			.site-header {
				border-bottom: 1px solid var(--color-border-subtle);
			}

			.nav {
				display: flex;
				align-items: center;
				gap: var(--spacing-4);
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 var(--spacing-5);
				height: var(--nav-height);
			}

			.site-title {
				font-weight: 700;
				color: var(--color-text);
				letter-spacing: var(--tracking-snug);
				white-space: nowrap;
			}

			.site-title:hover {
				color: var(--color-brand);
			}

			.nav-links {
				display: flex;
				column-gap: var(--spacing-4);
				font-size: var(--font-size-sm);
			}

			.nav-links a {
				color: var(--color-text-secondary);
			}

			.nav-links a:hover {
				color: var(--color-brand);
			}

			.site-search {
				margin-inline-start: auto;
			}

			.site-search-input {
				width: var(--search-input-width);
				padding: var(--spacing-1) var(--spacing-2);
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				border: 1px solid var(--input);
				border-radius: var(--radius);
				background: var(--color-bg);
				color: var(--color-text);
				transition:
					border-color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			.site-search-input::placeholder {
				color: var(--color-muted);
			}

			.site-search-input:focus,
			.site-search-input:focus-visible {
				outline: none;
				border-color: var(--ring);
				box-shadow: 0 0 0 3px var(--color-brand-ring);
			}

			main {
				flex: 1 0 auto;
				width: 100%;
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-6) var(--spacing-5) var(--spacing-16);
			}

			.site-footer {
				border-top: 1px solid var(--color-border-subtle);
			}

			.footer-inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-4) var(--spacing-5);
				font-size: var(--font-size-sm);
			}

			.newsletter-form {
				margin-bottom: var(--spacing-4);
				max-width: 360px;
			}

			.newsletter-label {
				display: block;
				font-size: var(--font-size-xs);
				color: var(--color-muted);
				margin-bottom: var(--spacing-1);
			}

			.newsletter-row {
				display: flex;
				gap: var(--spacing-2);
			}

			.newsletter-input {
				flex: 1;
				min-width: 0;
				padding: var(--spacing-1) var(--spacing-2);
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				border: 1px solid var(--input);
				border-radius: var(--radius);
				background: var(--color-bg);
				color: var(--color-text);
			}

			.newsletter-input:focus {
				outline: none;
				border-color: var(--ring);
				box-shadow: 0 0 0 3px var(--color-brand-ring);
			}

			.newsletter-button {
				padding: var(--spacing-1) var(--spacing-3);
				font-size: var(--font-size-sm);
				font-family: var(--font-body);
				background: var(--secondary);
				color: var(--secondary-foreground);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				cursor: pointer;
			}

			.newsletter-button:hover {
				color: var(--color-brand);
			}

			.newsletter-status {
				font-size: var(--font-size-xs);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
				min-height: 1em;
			}

			.footer-links {
				display: flex;
				flex-wrap: wrap;
				gap: var(--spacing-4);
				margin-bottom: var(--spacing-2);
			}

			.footer-links a {
				color: var(--color-text-secondary);
			}

			.footer-links a:hover {
				color: var(--color-brand);
			}

			.footer-copyright {
				color: var(--color-muted);
				font-size: var(--font-size-xs);
			}

			@media (max-width: 640px) {
				.nav {
					flex-wrap: wrap;
					height: auto;
					padding: var(--spacing-2) var(--spacing-4);
					row-gap: var(--spacing-1);
				}

				.site-search {
					width: 100%;
					margin-inline-start: 0;
				}

				.site-search-input {
					width: 100%;
				}
			}
		</style>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
