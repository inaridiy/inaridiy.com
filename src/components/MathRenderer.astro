---
/**
 * Client-side KaTeX auto-render. Only include this component on pages
 * whose content actually contains math delimiters — the katex JS chunk
 * loads only where needed, and the stylesheet is injected at runtime
 * (a static CSS import would get hoisted into every page's <head>).
 *
 * Supported delimiters: $$...$$ (display), \( ... \) and $...$ (inline),
 * \[ ... \] (display).
 */
---

<script>
	// @ts-expect-error — vite asset-url import
	import katexCssUrl from "katex/dist/katex.min.css?url";
	// @ts-expect-error — no bundled types for the contrib entry
	import renderMathInElement from "katex/dist/contrib/auto-render.mjs";

	if (!document.querySelector(`link[href="${katexCssUrl}"]`)) {
		const link = document.createElement("link");
		link.rel = "stylesheet";
		link.href = katexCssUrl;
		document.head.appendChild(link);
	}

	const target = document.querySelector(".article-content");
	if (target) {
		renderMathInElement(target, {
			delimiters: [
				{ left: "$$", right: "$$", display: true },
				{ left: "\\[", right: "\\]", display: true },
				{ left: "\\(", right: "\\)", display: false },
				{ left: "$", right: "$", display: false },
			],
			throwOnError: false,
		});
	}
</script>
