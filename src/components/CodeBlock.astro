---
/**
 * Custom Portable Text `code` block renderer.
 *
 * - Normal fences: server-side shiki highlighting (no client JS).
 * - ```github fences whose body is a GitHub blob permalink
 *   (https://github.com/o/r/blob/ref/path#L1-L20) are fetched from
 *   raw.githubusercontent.com at render time (edge-cached) and shown as a
 *   highlighted snippet with a source link. Works through the Markdown
 *   sync unchanged — the fence round-trips as plain text.
 */
import { highlight, languageFromPath } from "../lib/shiki";

interface Props {
	node: {
		_type: "code";
		_key: string;
		code?: string;
		language?: string;
		filename?: string;
	};
}

const { code = "", language, filename } = Astro.props.node ?? {};

const GITHUB_BLOB =
	/^https:\/\/github\.com\/([\w.-]+)\/([\w.-]+)\/blob\/([^/]+)\/(\S+?)(?:#L(\d+)(?:[-–]L?(\d+))?)?$/;

interface Embed {
	url: string;
	label: string;
	lang: string;
	snippet: string;
}

async function resolveGithubEmbed(raw: string): Promise<Embed | null> {
	const match = raw.trim().match(GITHUB_BLOB);
	if (!match) return null;
	const [, owner, repo, ref, path, fromRaw, toRaw] = match;
	try {
		const response = await fetch(
			`https://raw.githubusercontent.com/${owner}/${repo}/${ref}/${path}`,
			{ cf: { cacheTtl: 3600, cacheEverything: true } } as RequestInit,
		);
		if (!response.ok) return null;
		const text = await response.text();
		const lines = text.split("\n");
		const from = fromRaw ? Math.max(1, parseInt(fromRaw, 10)) : 1;
		const to = toRaw ? Math.min(lines.length, parseInt(toRaw, 10)) : fromRaw ? from : lines.length;
		const snippet = lines.slice(from - 1, to).join("\n");
		const range = fromRaw ? `#L${from}${to !== from ? `-L${to}` : ""}` : "";
		return {
			url: raw.trim(),
			label: `${owner}/${repo}/${path.split("/").pop()}${range}`,
			lang: languageFromPath(path),
			snippet,
		};
	} catch {
		return null;
	}
}

const embed = language === "github" ? await resolveGithubEmbed(code) : null;
const html = embed
	? await highlight(embed.snippet, embed.lang)
	: await highlight(code, language);
const header = embed ? embed.label : filename;
---

<figure class="code-block">
	{
		(header || embed) && (
			<figcaption class="code-header">
				{embed ? (
					<a href={embed.url} target="_blank" rel="noopener noreferrer">
						{header}
					</a>
				) : (
					header
				)}
			</figcaption>
		)
	}
	<div class="code-body" set:html={html} />
</figure>

<style>
	.code-block {
		margin: 1.6em 0;
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.code-header {
		padding: var(--spacing-1) var(--spacing-3);
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		background: var(--accent);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.code-header a {
		color: var(--color-text-secondary);
	}

	.code-header a:hover {
		color: var(--color-brand);
	}

	.code-body :global(pre) {
		margin: 0;
		padding: var(--spacing-4);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		line-height: 1.6;
		background: var(--secondary) !important;
	}

	.code-body :global(code) {
		background: none;
		padding: 0;
	}
</style>
