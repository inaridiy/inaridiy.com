---
import type { PortableTextBlock } from "emdash";
import { PortableText } from "emdash/ui";
import CodeBlock from "./CodeBlock.astro";
import MathRenderer from "./MathRenderer.astro";
import { hasMath } from "../utils/has-math";

interface Term {
	slug: string;
	label: string;
}

interface Props {
	slug: string;
	title: string;
	content?: PortableTextBlock[];
	publishDate: string | null;
	readingTime: number;
	lang?: "ja" | "en";
	isTranslated?: boolean;
	hasEnglish?: boolean;
	categories?: Term[];
	tags?: Term[];
	titleEdit?: Record<string, string>;
}

const {
	slug,
	title,
	content,
	publishDate,
	readingTime,
	lang = "ja",
	isTranslated = false,
	hasEnglish = false,
	categories = [],
	tags = [],
	titleEdit = {},
} = Astro.props;
---

<article class="article">
	<header class="article-header">
		<h1 class="article-title" {...titleEdit}>{title}</h1>
		<p class="article-meta">
			{publishDate && <time>{publishDate}</time>}
			{publishDate && " · "}
			{readingTime} min
			{
				lang === "ja" && categories.map((category) => (
					<>
						{" · "}
						<a href={`/category/${category.slug}`}>{category.label}</a>
					</>
				))
			}
			{
				lang === "ja" && hasEnglish && (
					<>
						{" · "}
						<a href={`/en/posts/${slug}`}>English</a>
					</>
				)
			}
			{lang === "en" && <> · <a href={`/posts/${slug}`}>日本語</a></>}
		</p>
		{
			lang === "en" && (
				<p class="translation-note">
					{isTranslated
						? "Auto-translated from Japanese by an LLM via Cloudflare AI Gateway."
						: "English translation is not available yet — showing the Japanese original below."}
					{isTranslated && <a href={`/posts/${slug}`}> Read the original.</a>}
				</p>
			)
		}
	</header>

	<div class="article-content">
		<PortableText value={content} components={{ type: { code: CodeBlock } }} />
	</div>
	{hasMath(content) && <MathRenderer />}

	{
		lang === "ja" && tags.length > 0 && (
			<footer class="article-footer">
				{tags.map((tag) => (
					<a href={`/tag/${tag.slug}`} class="tag">#{tag.label}</a>
				))}
			</footer>
		)
	}
</article>

<style>
	.article { max-width: var(--content-width); }
	.article-header { margin-bottom: var(--spacing-8); }
	.article-title {
		font-size: var(--font-size-2xl);
		line-height: var(--leading-snug);
		margin-bottom: var(--spacing-2);
	}
	.article-meta { font-size: var(--font-size-sm); color: var(--color-muted); }
	.translation-note {
		margin-top: var(--spacing-3);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		border-left: 2px solid var(--color-border);
		padding-left: var(--spacing-3);
	}
	.article-content { line-height: var(--leading-relaxed); }
	.article-content :global(p) { margin-bottom: 1.4em; }
	.article-content :global(h2) {
		font-size: var(--font-size-xl);
		margin-top: 2.2em;
		margin-bottom: 0.7em;
	}
	.article-content :global(h3) {
		font-size: var(--font-size-lg);
		margin-top: 1.8em;
		margin-bottom: 0.5em;
	}
	.article-content :global(blockquote) {
		margin: 1.6em 0;
		padding: var(--spacing-2) var(--spacing-4);
		border-left: 3px solid var(--color-border);
		color: var(--color-text-secondary);
	}
	.article-content :global(pre) {
		margin: 1.6em 0;
		padding: var(--spacing-4);
		background: var(--secondary);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		line-height: 1.6;
	}
	.article-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--secondary);
		padding: 0.15em 0.35em;
		border-radius: var(--radius-sm);
	}
	.article-content :global(pre code) { background: none; padding: 0; }
	.article-content :global(ul),
	.article-content :global(ol) { margin-bottom: 1.4em; padding-left: 1.5em; }
	.article-content :global(li) { margin-bottom: 0.4em; }
	.article-content :global(img) { margin: 1.6em 0; border-radius: var(--radius-lg); }
	.article-content :global(hr) {
		margin: 2.4em 0;
		border: none;
		border-top: 1px solid var(--color-border);
	}
	.article-content :global(a) {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}
	.article-footer {
		margin-top: var(--spacing-8);
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}
	.tag { font-size: var(--font-size-sm); color: var(--color-text-secondary); }
	.tag:hover { color: var(--color-brand); }
</style>
